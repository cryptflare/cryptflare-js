{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "stripInternal": true,
    "noEmit": false,
    // tsup's DTS step injects `baseUrl`, which TS 6 flags as deprecated.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "tests", "scripts"]
}
